# ===========================================
# OpenClaw on Fly.io + Tailscale - Environment
# ===========================================
# This file is for REFERENCE ONLY. Do not fill it out.
# The setup script (./setup.sh) handles all of this
# and sets them as Fly.io secrets automatically.

# --- Required ---

# Tailscale auth key (reusable + ephemeral recommended)
# Generate at: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-...

# Gateway authentication token
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# AI provider API keys (set one or both)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Optional: Channel tokens ---

# Discord bot token
# DISCORD_BOT_TOKEN=

# Telegram bot token
# TELEGRAM_BOT_TOKEN=
